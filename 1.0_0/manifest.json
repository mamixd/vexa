{
   "background": {
      "persistent": false,
      "scripts": [ "background.js" ]
   },
   "content_scripts": [ {
      "js": [ "haxemotion.js" ],
      "matches": [ "https://*.haxball.com/play*" ],
      "run_at": "document_end"
   } ],
   "description": "Herhangi bir tuşa atamanızı yapın ve otomatik olarak avatarınız değişsin!",
   "icons": {
      "128": "HaxEmotionAvatar128.png",
      "48": "HaxEmotionAvatar48.png"
   },
   "key": "",
   "manifest_version": 2,
   "name": "HaxBall Online | Avatar Reaction",
   "page_action": {
      "default_icon": {
         "128": "HaxEmotionAvatar128.png",
         "48": "HaxEmotionAvatar48.png"
      },
      "default_popup": "popup.html"
   },
   "permissions": [ "activeTab", "declarativeContent", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0"
}
