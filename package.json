{
  "name": "vexa-haxball-client",
  "version": "1.1.11",
  "description": "Advanced Modular HaxBall Electron Client",
  "author": "Vexa",
  "homepage": "https://vexa.gg",
  "repository": {
    "type": "git",
    "url": "https://github.com/vexa-client/vexa.git"
  },
  "main": "launcher/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:client": "electron-builder --win --config electron-builder-client.json",
    "package:client": "node package_client.js",
    "build:full": "npm run build && npm run build:client && npm run package:client"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "express": "^4.19.2",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.vexa.launcher",
    "productName": "Vexa Launcher",
    "copyright": "Copyright © 2026 Vexa Software",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "launcher/**/*",
      "node_modules/**/*",
      "package.json",
      "build/**/*"
    ],
    "extraMetadata": {
      "main": "launcher/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Vexa Software",
      "legalTrademarks": "Vexa",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "Vexa Launcher",
      "allowElevation": false,
      "unicode": true,
      "installerHeader": "build/installer_header.bmp",
      "installerSidebar": "build/installer_sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vexa Launcher",
      "artifactName": "vexa-launcher-setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "hbr2",
        "name": "Haxball Replay",
        "description": "Vexa Haxball Client Replay File",
        "role": "Viewer"
      }
    ],
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "vexa-client",
      "repo": "vexa"
    }
  }
}
